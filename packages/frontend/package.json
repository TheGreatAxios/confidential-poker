{
  "name": "ai-poker-night-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "rm -rf node_modules/@reown/appkit-controllers/node_modules/viem",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "bun run build && wrangler dev",
    "lint": "oxlint . --tsconfig tsconfig.json --ignore-path .gitignore --ignore-pattern .next --ignore-pattern dist",
    "lint:fix": "oxlint . --tsconfig tsconfig.json --fix --ignore-path .gitignore --ignore-pattern .next --ignore-pattern dist",
    "typecheck": "tsc --noEmit",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@reown/appkit": "1.8.19",
    "@reown/appkit-adapter-wagmi": "1.8.19",
    "@tanstack/react-query": "5.100.9",
    "@wagmi/core": "^3.4.9",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "viem": "^2.48.11",
    "wagmi": "^3.6.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.36.3",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "oxlint": "^1.63.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "wrangler": "^4.90.0"
  }
}
