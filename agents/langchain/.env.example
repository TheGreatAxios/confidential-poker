# Required
PRIVATE_KEY=
LLM_API_KEY=

# Deployment lives in src/deployment.ts

# LLM Configuration
LLM_PROVIDER=anthropic
# Supported: anthropic, openai, xai, google-genai, openrouter, zai
LLM_MODEL=claude-sonnet-4-6

# ZAI (Z.AI / GLM) — OpenAI-compatible, uses ChatOpenAI with custom base URL
# Get your key at https://z.ai
ZAI_PRIVATE_KEY=
ZAI_MODEL=glm-5.1

# Memory (memory, sqlite, or postgres)
MEMORY_BACKEND=memory
DATABASE_URL=

# Strategy (shark, fox, owl, bull, cat, wolf, custom)
STRATEGY=wolf
CUSTOM_PROMPT=

# Loop timing
POLL_INTERVAL_MS=5000
IDLE_BALANCE_CHECK_MS=60000

# Logging
LOG_LEVEL=info
